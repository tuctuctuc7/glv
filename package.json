{
  "name": "agenthic-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Agenthic Lab dashboard hub for client dashboards at lab.agenthic.com.",
  "scripts": {
    "export:glv": "/home/tom/.config/fb-sync/.venv/bin/python ./export_glv_dashboard.py",
    "test": "node --test tests/*.test.cjs",
    "verify:glv-release": "node scripts/verify-glv-release.cjs",
    "qa:browser": "GLV_QA_EVIDENCE_DIR=${GLV_QA_EVIDENCE_DIR:-/tmp/glv-bi-qa-screenshots} node qa/browser-smoke.cjs",
    "qa:elm-theme": "ELM_THEME_QA_EVIDENCE_DIR=${ELM_THEME_QA_EVIDENCE_DIR:-/tmp/elm-theme-qa} node qa/elm-theme-smoke.cjs",
    "qa:meta-ads": "node qa/meta-ads-smoke.cjs",
    "deploy": "vercel --prod --yes --scope agenthic"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright-core": "^1.54.2"
  }
}
