{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run verify:glv-release",
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/glv-meta-ads/fb-data.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-promo-format.cjs,public/glv-meta-ads/promo-format.js}"
    },
    "api/glv-meta-ads/cron.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-promo-format.cjs,public/glv-meta-ads/promo-format.js}"
    }
  },
  "rewrites": [
    {
      "source": "/krs-meta-ads/",
      "destination": "https://kursa-cyan.vercel.app/krs-meta-ads/"
    },
    {
      "source": "/krs-meta-ads/login/",
      "destination": "https://kursa-cyan.vercel.app/krs-meta-ads/login/"
    },
    {
      "source": "/krs-meta-ads/:path*",
      "destination": "https://kursa-cyan.vercel.app/krs-meta-ads/:path*"
    },
    {
      "source": "/api/krs-meta-ads/:path*",
      "destination": "https://kursa-cyan.vercel.app/api/krs-meta-ads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/glv/glv_dashboard.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/glv/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/elm-meta-ads/elm_meta_ads.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/glv-meta-ads/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
