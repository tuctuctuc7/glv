{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run verify:glv-release",
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/glv-meta-ads/fb-data.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-mad-shared*.cjs,lib/glv-history*.cjs,lib/glv-meta-dates.cjs,lib/glv-promo-format.cjs,lib/glv-promo-assets.cjs,public/glv-meta-ads/promo-format.js}"
    },
    "api/glv-meta-ads/cron.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-mad-shared*.cjs,lib/glv-history*.cjs,lib/glv-meta-dates.cjs,lib/glv-promo-format.cjs,lib/glv-promo-assets.cjs,public/glv-meta-ads/promo-format.js,lib/glv-mad-v2*.cjs,public/glv-meta-ads-v2/dates.js}"
    },
    "api/glv-meta-ads-v2/fb-data.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-mad-shared*.cjs,lib/glv-history*.cjs,lib/glv-mad-v2*.cjs,public/glv-meta-ads-v2/dates.js,public/glv-meta-ads/promo-format.js}"
    },
    "api/krs-meta-ads/fb-data.js": {
      "maxDuration": 60
    },
    "api/krs-meta-ads/cron.js": {
      "maxDuration": 10
    },
    "api/glv-meta-ads/cron-tuc.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-mad-shared*.cjs,lib/glv-history*.cjs,lib/glv-meta-dates.cjs,lib/glv-promo-format.cjs,lib/glv-promo-assets.cjs,public/glv-meta-ads/promo-format.js,lib/glv-mad-v2*.cjs,public/glv-meta-ads-v2/dates.js}"
    },
    "api/glv-meta-ads/cron-v2.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-mad-shared*.cjs,lib/glv-history*.cjs,lib/glv-meta-dates.cjs,lib/glv-promo-format.cjs,lib/glv-promo-assets.cjs,public/glv-meta-ads/promo-format.js,lib/glv-mad-v2*.cjs,public/glv-meta-ads-v2/dates.js}"
    },
    "api/glv-meta-ads/cron-tglv.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/glv-mad-shared*.cjs,lib/glv-history*.cjs,lib/glv-meta-dates.cjs,lib/glv-promo-format.cjs,lib/glv-promo-assets.cjs,public/glv-meta-ads/promo-format.js,lib/glv-mad-v2*.cjs,public/glv-meta-ads-v2/dates.js}"
    }
  },
  "rewrites": [
    {
      "source": "/krs-meta-ads/",
      "destination": "https://kursa-cyan.vercel.app/krs-meta-ads/"
    },
    {
      "source": "/krs-meta-ads/login/",
      "destination": "https://kursa-cyan.vercel.app/krs-meta-ads/login/"
    },
    {
      "source": "/krs-meta-ads/:path*",
      "destination": "https://kursa-cyan.vercel.app/krs-meta-ads/:path*"
    },
    {
      "source": "/api/krs-meta-ads/auth",
      "destination": "https://kursa-cyan.vercel.app/api/krs-meta-ads/auth"
    }
  ],
  "headers": [
    {
      "source": "/glv/glv_dashboard.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/glv/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/elm-meta-ads/elm_meta_ads.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/glv-meta-ads/cron-tuc",
      "schedule": "0,20,40 0 * * *"
    },
    {
      "path": "/api/glv-meta-ads/cron-tuc",
      "schedule": "0 3,6,12,18,21 * * *"
    },
    {
      "path": "/api/glv-meta-ads/cron-v2",
      "schedule": "10,30,50 0,1 * * *"
    },
    {
      "path": "/api/glv-meta-ads/cron-v2",
      "schedule": "10 3,6,12,18,21 * * *"
    },
    {
      "path": "/api/glv-meta-ads/cron-tglv",
      "schedule": "0,15,30,45 8,9 * * *"
    },
    {
      "path": "/api/glv-meta-ads/cron-tglv",
      "schedule": "0 11,14 * * *"
    }
  ]
}
